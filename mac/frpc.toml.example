# Mac mini 端 —— frpc 反向隧道客户端配置（脱敏模板）
#
# 用法：把下面所有 <...> 占位符替换成真实值，存到
#   /usr/local/etc/nas-tunnel/frpc.toml   （权限 600）
# 真实值在服务器上执行 `bash deploy-nas-tunnel.sh --status` 获取。

# ⚠️ serverAddr 故意写 127.0.0.1，不要改成服务器 IP！
#
# frpc 并不直连服务器，而是把这个「CONNECT 127.0.0.1:7000」交给下面
# transport.proxyURL 指定的本地 socks5（也就是 Hysteria2 客户端的入站），
# 由**服务器端的 Hysteria2 进程在服务器本机**拨号到 frps。
#
# 这样带来的好处：Mac↔服务器 的公网段全程只有 UDP（QUIC），
# 一个 TCP 包都不走公网；frps 也因此能只绑 127.0.0.1、不暴露任何公网端口。
serverAddr = "127.0.0.1"
serverPort = 7000
loginFailExit = false          # 登录失败不退出，靠 launchd 的 KeepAlive 重试

auth.method = "token"
auth.token = "<frp_token>"

# 连接服务器时走本机 Hysteria2 的 socks5 入站（端口/账号密码见 --status）
transport.proxyURL = "socks5://<socks5用户名>:<socks5密码>@127.0.0.1:1080"
transport.tcpMux = true
# Hysteria2 已做端到端加密，去掉 frp 自带的 TLS 层，省 CPU 与延迟
transport.tls.enable = false

log.to = "/var/log/frpc.log"
log.level = "info"
log.maxDays = 3
log.disablePrintColor = true

# 把「服务器上的 <远端端口>」接到「Mac 的 5244（OpenList）」
[[proxies]]
name = "openlist"
type = "tcp"
localIP = "127.0.0.1"
localPort = 5244
remotePort = 15244

# 需要再暴露别的端口就照抄一段。注意：Caddy 只反代了 remotePort=15244，
# 其他端口要在服务器安全组放行、或另加 Caddy 站点才能从公网访问。
# [[proxies]]
# name = "jellyfin"
# type = "tcp"
# localIP = "127.0.0.1"
# localPort = 8096
# remotePort = 15245
